<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kontrol Paneli | Mekatronik Mühendisliğine Giriş Dersi Sunum Ödevi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css">
    <style>
        .alarm-card {
            border: 2px solid #dc3545 !important;
            animation: cardBlink 0.7s infinite;
        }
        @keyframes cardBlink {
            50% { background-color: rgba(220, 53, 69, 0.22) !important; }
        }
    </style>
</head>

<body data-bs-theme="dark">
    <div class="container-fluid row">
        <div class="col-0-75 bg-darker vh-100 p-3 text-white">
            <ul class="nav flex-column">
                <li class="nav-item sekme">
                    <a class="nav-link text-white w-100 text-center" href="/"><i
                            class="bi bi-columns-gap fs-1 text-center"></i></a>
                </li>
                <li class="nav-item sekme mt-2">
                    <a class="nav-link text-white w-100 text-center" href="/sensorler"><i
                            class="bi bi-activity fs-1 text-center"></i></a>
                </li>

                <li class="nav-item sekme mt-2">
                    <a class="nav-link text-white w-100 text-center" href="/ayarlar"><i
                            class="bi bi-gear fs-1 text-center"></i></a>
                </li>
            </ul>
            <ul style="left: 0; justify-content: center; align-items: center;"
                class="nav flex-column position-absolute bottom-0 mb-3 text-center ms-0 ps-0">
                <li class="nav-item text-center">
                    <p class="nav-link text-white w-100 text-center small">İsmail<br>AYDINLIK</p>
                </li>
            </ul>
        </div>
        <div class="col-11-25 bg-dark p-3">
            <h1>Sensörler</h1>
            <p>Sensör verilerine ve grafiklerine aşağıdan ulaşabilirsiniz.</p>
            <div class="row g-3 p-3">
                <div class="col-md-4">
                    <div id="card-ultrasonik" class="sensorGraph rounded shadow-sm p-3 bg-body-tertiary h-100">
                        <h3 class="text-center"><i class="bi bi-rulers text-info me-2"></i>Ultrasonik Mesafe Sensörü</h3>
                        <canvas id="ultrasonikGrafigi"></canvas>
                    </div>
                </div>

                <div class="col-md-4">
                    <div id="card-sicaklik" class="sensorGraph rounded shadow-sm p-3 bg-body-tertiary h-100">
                        <h3 class="text-center"><i class="bi bi-thermometer-half text-info me-2"></i>Sıcaklık Sensörü</h3>
                        <canvas id="sicaklikGrafigi"></canvas>
                    </div>
                </div>

                <div class="col-md-4">
                    <div id="card-nem" class="sensorGraph rounded shadow-sm p-3 bg-body-tertiary h-100">
                        <h3 class="text-center"><i class="bi bi-droplet text-info me-2"></i>Nem Sensörü</h3>
                        <h1 class="text-center mt-5" id="nemDegeri">0%</h1>
                        <div class="progress mt-5" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" id="nemBar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div id="card-isik" class="sensorGraph rounded shadow-sm p-3 bg-body-tertiary h-100">
                        <h3 class="text-center"><i class="bi bi-sun text-info me-2"></i>Işık Sensörü</h3>
                        <h1 class="text-center mt-5" id="isikDegeri">0</h1>
                    </div>
                </div>

                <div class="col-md-4">
                    <div id="card-gaz" class="sensorGraph rounded shadow-sm p-3 bg-body-tertiary h-100">
                        <h3 class="text-center"><i class="bi bi-cloud-haze2 text-info me-2"></i>Gaz Sensörü</h3>
                        <h1 class="text-center mt-5" id="gazDegeri">0</h1>
                    </div>
                </div>

                <div class="col-md-4">
                    <div id="card-titresim" class="sensorGraph rounded shadow-sm p-3 bg-body-tertiary h-100">
                        <h3 class="text-center"><i class="bi bi-activity text-info me-2"></i>Titreşim Sensörü</h3>
                        <h1 class="text-center mt-5" id="titreşimDegeri">0</h1>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.3.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.socket.io/4.8.4/socket.io.min.js"></script>
    <script>
        const socket = io();
        let settings = {};
        let audioCtx = null;
        let sonAlarmSes = 0;

        async function ayarlariYukle() {
            try {
                const res = await fetch('/getSettingsData', { method: 'POST' });
                settings = await res.json();
            } catch (e) {}
        }

        ayarlariYukle();
        setInterval(ayarlariYukle, 3000);

        function alarmSesiCal() {
            const simdi = Date.now();
            if (simdi - sonAlarmSes < 700) return;
            sonAlarmSes = simdi;
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'square';
            osc.frequency.setValueAtTime(880, audioCtx.currentTime);
            gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.25);
        }

        function esikKontrol(sensorKey, cardId, deger) {
            const card = document.getElementById(cardId);
            const limit = settings[sensorKey];
            if (!limit || (limit.min === 0 && limit.max === 0) || deger === null || deger === undefined) {
                card.classList.remove('alarm-card');
                return false;
            }
            const asildi = deger < limit.min || deger > limit.max;
            if (asildi) {
                card.classList.add('alarm-card');
                alarmSesiCal();
                socket.emit('alarmData', {
                    sensor: sensorKey,
                    value: deger,
                    min: limit.min,
                    max: limit.max,
                    time: new Date().toLocaleTimeString('tr-TR')
                });
            } else {
                card.classList.remove('alarm-card');
            }
            return asildi;
        }

        const ultrasonikChart = new Chart(document.getElementById('ultrasonikGrafigi').getContext('2d'), {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Mesafe (cm)',
                    data: [],
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.15)',
                    borderWidth: 2,
                    tension: 0.3,
                    fill: true,
                    spanGaps: false
                }]
            },
            options: {
                responsive: true,
                animation: { duration: 0 },
                scales: {
                    x: { title: { display: true, text: 'Zaman' } },
                    y: { title: { display: true, text: 'Mesafe (cm)' }, beginAtZero: true }
                }
            }
        });

        const sicaklikChart = new Chart(document.getElementById('sicaklikGrafigi').getContext('2d'), {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Sıcaklık (°C)',
                    data: [],
                    borderColor: 'rgba(255, 193, 7, 1)',
                    backgroundColor: 'rgba(255, 193, 7, 0.15)',
                    borderWidth: 2,
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                animation: { duration: 0 },
                scales: {
                    x: { title: { display: true, text: 'Zaman' } },
                    y: { title: { display: true, text: 'Sıcaklık (°C)' }, beginAtZero: true }
                }
            }
        });

        socket.on('ultrasonikData', (data) => {
            const currentTime = new Date().toLocaleTimeString('tr-TR');
            const mesafeCm = (data.detected !== false && data.distanceMm !== null) ? Number((data.distanceMm / 10).toFixed(1)) : null;

            esikKontrol('ultrasonik', 'card-ultrasonik', mesafeCm);

            ultrasonikChart.data.labels.push(currentTime);
            ultrasonikChart.data.datasets[0].data.push(mesafeCm);
            if (ultrasonikChart.data.labels.length > 20) {
                ultrasonikChart.data.labels.shift();
                ultrasonikChart.data.datasets[0].data.shift();
            }
            ultrasonikChart.update();
        });

        socket.on('sicaklikData', (data) => {
            const currentTime = new Date().toLocaleTimeString('tr-TR');
            const deger = Number(data.value);

            esikKontrol('sicaklik', 'card-sicaklik', deger);

            sicaklikChart.data.labels.push(currentTime);
            sicaklikChart.data.datasets[0].data.push(deger);
            if (sicaklikChart.data.labels.length > 20) {
                sicaklikChart.data.labels.shift();
                sicaklikChart.data.datasets[0].data.shift();
            }
            sicaklikChart.update();
        });

        socket.on('nemData', (data) => {
            const deger = Number(data.value);
            const alarm = esikKontrol('nem', 'card-nem', deger);
            document.getElementById('nemDegeri').textContent = deger + '%';
            const bar = document.getElementById('nemBar');
            bar.style.width = deger + '%';
            bar.className = alarm ? 'progress-bar bg-danger' : 'progress-bar bg-info';
        });

        socket.on('isikData', (data) => {
            const deger = Number(data.value);
            const alarm = esikKontrol('isik', 'card-isik', deger);
            const el = document.getElementById('isikDegeri');
            el.textContent = deger + ' lux';
            el.className = alarm ? 'text-center mt-5 text-danger' : 'text-center mt-5';
        });

        socket.on('gazData', (data) => {
            const deger = Number(data.value);
            const alarm = esikKontrol('gas', 'card-gaz', deger);
            const el = document.getElementById('gazDegeri');
            el.textContent = deger + ' ppm';
            el.className = alarm ? 'text-center mt-5 text-danger' : 'text-center mt-5';
        });

        socket.on('titresimData', (data) => {
            const deger = Number(data.value);
            const alarm = esikKontrol('titresim', 'card-titresim', deger);
            const el = document.getElementById('titreşimDegeri');
            el.textContent = deger;
            el.className = alarm ? 'text-center mt-5 text-danger' : 'text-center mt-5';
        });
    </script>
</body>

</html>